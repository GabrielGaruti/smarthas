digraph DER {
graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.1, bgcolor="white", fontname="Helvetica", pad=0.4];
node [shape=plain, fontname="Helvetica"];
edge [color="#6b7280", arrowhead=none, penwidth=1.3, taillabel="1", headlabel="N", labelfontsize=13, labelfontcolor="#b91c1c", labeldistance=1.6];
T_SHAS_USUARIO [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#7f1d1d"><font color="white"><b>T_SHAS_USUARIO</b></font></td></tr><tr><td align="left" port="ID_USUARIO"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_USUARIO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="NM_COMPLETO"><font color="#374151"><b> </b></font></td><td align="left">NM_COMPLETO</td><td align="left"><font color="#6b7280">VARCHAR2(120)</font></td></tr><tr><td align="left" port="DS_EMAIL"><font color="#047857"><b>UK</b></font></td><td align="left">DS_EMAIL</td><td align="left"><font color="#6b7280">VARCHAR2(150)</font></td></tr><tr><td align="left" port="DS_SENHA_HASH"><font color="#374151"><b> </b></font></td><td align="left">DS_SENHA_HASH</td><td align="left"><font color="#6b7280">VARCHAR2(100)</font></td></tr><tr><td align="left" port="TP_PERFIL"><font color="#374151"><b> </b></font></td><td align="left">TP_PERFIL</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="DT_CADASTRO"><font color="#374151"><b> </b></font></td><td align="left">DT_CADASTRO</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr></table>>];
T_SHAS_DISPOSITIVO [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#7f1d1d"><font color="white"><b>T_SHAS_DISPOSITIVO</b></font></td></tr><tr><td align="left" port="ID_DISPOSITIVO"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_DISPOSITIVO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="ID_USUARIO"><font color="#1d4ed8"><b>FK</b></font></td><td align="left">ID_USUARIO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="CD_SERIE"><font color="#047857"><b>UK</b></font></td><td align="left">CD_SERIE</td><td align="left"><font color="#6b7280">VARCHAR2(40)</font></td></tr><tr><td align="left" port="DS_MODELO"><font color="#374151"><b> </b></font></td><td align="left">DS_MODELO</td><td align="left"><font color="#6b7280">VARCHAR2(80)</font></td></tr><tr><td align="left" port="ST_ATIVO"><font color="#374151"><b> </b></font></td><td align="left">ST_ATIVO</td><td align="left"><font color="#6b7280">NUMBER(1)</font></td></tr><tr><td align="left" port="DT_ULTIMA_SYNC"><font color="#374151"><b> </b></font></td><td align="left">DT_ULTIMA_SYNC</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr></table>>];
T_SHAS_MEDICAO [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#7f1d1d"><font color="white"><b>T_SHAS_MEDICAO</b></font></td></tr><tr><td align="left" port="ID_MEDICAO"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_MEDICAO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="ID_USUARIO"><font color="#1d4ed8"><b>FK</b></font></td><td align="left">ID_USUARIO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="ID_DISPOSITIVO"><font color="#1d4ed8"><b>FK</b></font></td><td align="left">ID_DISPOSITIVO</td><td align="left"><font color="#6b7280">NUMBER (null)</font></td></tr><tr><td align="left" port="VL_SISTOLICA"><font color="#374151"><b> </b></font></td><td align="left">VL_SISTOLICA</td><td align="left"><font color="#6b7280">NUMBER(3)</font></td></tr><tr><td align="left" port="VL_DIASTOLICA"><font color="#374151"><b> </b></font></td><td align="left">VL_DIASTOLICA</td><td align="left"><font color="#6b7280">NUMBER(3)</font></td></tr><tr><td align="left" port="VL_FREQ_CARDIACA"><font color="#374151"><b> </b></font></td><td align="left">VL_FREQ_CARDIACA</td><td align="left"><font color="#6b7280">NUMBER(3)</font></td></tr><tr><td align="left" port="DT_MEDICAO"><font color="#374151"><b> </b></font></td><td align="left">DT_MEDICAO</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr><tr><td align="left" port="TP_ORIGEM"><font color="#374151"><b> </b></font></td><td align="left">TP_ORIGEM</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="DS_OBSERVACAO"><font color="#374151"><b> </b></font></td><td align="left">DS_OBSERVACAO</td><td align="left"><font color="#6b7280">VARCHAR2(500)</font></td></tr><tr><td align="left" port="DT_REGISTRO"><font color="#374151"><b> </b></font></td><td align="left">DT_REGISTRO</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr></table>>];
T_SHAS_ALERTA [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#7f1d1d"><font color="white"><b>T_SHAS_ALERTA</b></font></td></tr><tr><td align="left" port="ID_ALERTA"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_ALERTA</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="ID_USUARIO"><font color="#1d4ed8"><b>FK</b></font></td><td align="left">ID_USUARIO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="ID_MEDICAO"><font color="#1d4ed8"><b>FK</b></font></td><td align="left">ID_MEDICAO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="TP_ALERTA"><font color="#374151"><b> </b></font></td><td align="left">TP_ALERTA</td><td align="left"><font color="#6b7280">VARCHAR2(30)</font></td></tr><tr><td align="left" port="NV_SEVERIDADE"><font color="#374151"><b> </b></font></td><td align="left">NV_SEVERIDADE</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="DS_MENSAGEM"><font color="#374151"><b> </b></font></td><td align="left">DS_MENSAGEM</td><td align="left"><font color="#6b7280">VARCHAR2(400)</font></td></tr><tr><td align="left" port="ST_ALERTA"><font color="#374151"><b> </b></font></td><td align="left">ST_ALERTA</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="DT_ALERTA"><font color="#374151"><b> </b></font></td><td align="left">DT_ALERTA</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr><tr><td align="left" port="DT_RESOLUCAO"><font color="#374151"><b> </b></font></td><td align="left">DT_RESOLUCAO</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr></table>>];
T_SHAS_RELATORIO_RESUMO [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#7f1d1d"><font color="white"><b>T_SHAS_RELATORIO_RESUMO</b></font></td></tr><tr><td align="left" port="ID_RELATORIO"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_RELATORIO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="ID_USUARIO"><font color="#1d4ed8"><b>FK</b></font></td><td align="left">ID_USUARIO</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="DTI"><font color="#374151"><b> </b></font></td><td align="left">DT_INICIO / DT_FIM</td><td align="left"><font color="#6b7280">DATE</font></td></tr><tr><td align="left" port="QT_MEDICOES"><font color="#374151"><b> </b></font></td><td align="left">QT_MEDICOES</td><td align="left"><font color="#6b7280">NUMBER(6)</font></td></tr><tr><td align="left" port="VMS"><font color="#374151"><b> </b></font></td><td align="left">VL_MEDIA_SIS / DIA</td><td align="left"><font color="#6b7280">NUMBER(5,1)</font></td></tr><tr><td align="left" port="VL_MAX_SISTOLICA"><font color="#374151"><b> </b></font></td><td align="left">VL_MAX_SISTOLICA</td><td align="left"><font color="#6b7280">NUMBER(3)</font></td></tr><tr><td align="left" port="PC_CONTROLE"><font color="#374151"><b> </b></font></td><td align="left">PC_CONTROLE</td><td align="left"><font color="#6b7280">NUMBER(5,1)</font></td></tr><tr><td align="left" port="QT_ALERTAS_ABERTOS"><font color="#374151"><b> </b></font></td><td align="left">QT_ALERTAS_ABERTOS</td><td align="left"><font color="#6b7280">NUMBER(6)</font></td></tr><tr><td align="left" port="NV_RISCO"><font color="#374151"><b> </b></font></td><td align="left">NV_RISCO</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="DS_RESUMO"><font color="#374151"><b> </b></font></td><td align="left">DS_RESUMO</td><td align="left"><font color="#6b7280">VARCHAR2(400)</font></td></tr><tr><td align="left" port="DT_GERACAO"><font color="#374151"><b> </b></font></td><td align="left">DT_GERACAO</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr></table>>];
T_SHAS_UNIDADE_SAUDE [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#4b5563"><font color="white"><b>T_SHAS_UNIDADE_SAUDE</b></font></td></tr><tr><td align="left" port="ID_UNIDADE"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_UNIDADE</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="NM_UNIDADE"><font color="#374151"><b> </b></font></td><td align="left">NM_UNIDADE</td><td align="left"><font color="#6b7280">VARCHAR2(120)</font></td></tr><tr><td align="left" port="TP_UNIDADE"><font color="#374151"><b> </b></font></td><td align="left">TP_UNIDADE</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="VL_LATITUDE"><font color="#374151"><b> </b></font></td><td align="left">VL_LATITUDE</td><td align="left"><font color="#6b7280">NUMBER(9,6)</font></td></tr><tr><td align="left" port="VL_LONGITUDE"><font color="#374151"><b> </b></font></td><td align="left">VL_LONGITUDE</td><td align="left"><font color="#6b7280">NUMBER(9,6)</font></td></tr><tr><td align="left" port="DS_ENDERECO"><font color="#374151"><b> </b></font></td><td align="left">DS_ENDERECO</td><td align="left"><font color="#6b7280">VARCHAR2(200)</font></td></tr><tr><td align="left" port="ST_ATIVO"><font color="#374151"><b> </b></font></td><td align="left">ST_ATIVO</td><td align="left"><font color="#6b7280">NUMBER(1)</font></td></tr></table>>];
T_SHAS_LOG_PROCESSAMENTO [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="3" bgcolor="#4b5563"><font color="white"><b>T_SHAS_LOG_PROCESSAMENTO</b></font></td></tr><tr><td align="left" port="ID_LOG"><font color="#b91c1c"><b>PK</b></font></td><td align="left">ID_LOG</td><td align="left"><font color="#6b7280">NUMBER</font></td></tr><tr><td align="left" port="NM_ROTINA"><font color="#374151"><b> </b></font></td><td align="left">NM_ROTINA</td><td align="left"><font color="#6b7280">VARCHAR2(60)</font></td></tr><tr><td align="left" port="TP_EVENTO"><font color="#374151"><b> </b></font></td><td align="left">TP_EVENTO</td><td align="left"><font color="#6b7280">VARCHAR2(10)</font></td></tr><tr><td align="left" port="DS_MENSAGEM"><font color="#374151"><b> </b></font></td><td align="left">DS_MENSAGEM</td><td align="left"><font color="#6b7280">VARCHAR2(4000)</font></td></tr><tr><td align="left" port="DT_LOG"><font color="#374151"><b> </b></font></td><td align="left">DT_LOG</td><td align="left"><font color="#6b7280">TIMESTAMP</font></td></tr></table>>];
T_SHAS_USUARIO -> T_SHAS_DISPOSITIVO [xlabel="possui", fontsize=10, fontcolor="#6b7280"];
T_SHAS_USUARIO -> T_SHAS_MEDICAO [xlabel="registra", fontsize=10, fontcolor="#6b7280"];
T_SHAS_DISPOSITIVO -> T_SHAS_MEDICAO [xlabel="envia", fontsize=10, fontcolor="#6b7280"];
T_SHAS_MEDICAO -> T_SHAS_ALERTA [xlabel="gera", fontsize=10, fontcolor="#6b7280"];
T_SHAS_USUARIO -> T_SHAS_ALERTA [xlabel="recebe", fontsize=10, fontcolor="#6b7280"];
T_SHAS_USUARIO -> T_SHAS_RELATORIO_RESUMO [xlabel="consolida", fontsize=10, fontcolor="#6b7280"];
{rank=same; T_SHAS_UNIDADE_SAUDE; T_SHAS_LOG_PROCESSAMENTO;}
}