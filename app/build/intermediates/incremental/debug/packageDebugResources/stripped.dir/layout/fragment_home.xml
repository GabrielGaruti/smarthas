<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_large"
    android:background="@color/background">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txt_greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_greeting"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="@dimen/padding_large" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/padding_large"
        app:cardBackgroundColor="@color/surface"
        app:cardElevation="@dimen/card_elevation"
        app:cardCornerRadius="@dimen/corner_radius_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_large">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_last_measurement"
                android:textSize="16sp"
                android:textColor="@color/secondary"
                android:layout_marginBottom="@dimen/padding_medium" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txt_last_measurement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_no_measurements"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="@dimen/padding_medium" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_status"
                android:textSize="14sp"
                android:textColor="@color/secondary"
                android:layout_marginBottom="@dimen/padding_small" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/badge_normal" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_measurement"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="@string/home_new_measurement_button"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary" />

</LinearLayout>
