<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large"
        android:gravity="center">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:textSize="96sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txt_developer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gabriel Garuti Paiva Cracco"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/padding_small" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txt_rm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RM554866"
            android:textSize="16sp"
            android:textColor="@color/secondary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txt_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart HAS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/padding_small" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="14sp"
            android:textColor="@color/secondary"
            android:gravity="center"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txt_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Versão 1.0 - 2025"
            android:textSize="12sp"
            android:textColor="@color/neutral_10"
            android:gravity="center"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIAP - Fase 3\nDesenvolvido em Kotlin + Android Studio"
            android:textSize="12sp"
            android:textColor="@color/secondary"
            android:gravity="center"
            android:layout_marginTop="@dimen/padding_large" />

    </LinearLayout>

</ScrollView>
